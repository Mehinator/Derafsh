# --- فایل‌های بیلد و ویژوال استودیو ---
[Bb]in/
[Oo]bj/
.vs/
*.user
*.suo
*.userprefs
publish/
__pycache__/

# --- فایل‌های شخصی (نباید توی گیت عمومی برن) ---
configs.txt
derafsh_debug.txt

# --- خروجی‌های ریلیز: این‌ها توی بخش Releases گیت‌هاب آپلود می‌شن، نه توی خود ریپو ---
*.zip
Derafsh_Release/
DerafshFinal/

# --- فایل‌هایی که برنامه موقع اجرا کنار xray می‌سازه ---
xray_log.txt
# نکته: Derafsh.Client/Core/xray.exe و geoip/geosite عمداً داخل ریپو هستن، چون بیلد برنامه اون‌ها رو کنار exe کپی می‌کنه

# --- لاگ و فایل‌های ویندوز ---
*.log
[Tt]humbs.db

# Android engine binaries (downloaded and SHA-256 checked by the build)
Derafsh.Client/Platforms/Android/native/
Derafsh.Client/Platforms/Android/libs/*.aar

# Windows engine (downloaded and SHA-256 checked by the build, see FetchWindowsEngine in the csproj)
Derafsh.Client/Core/xray.exe
Derafsh.Client/Core/geoip.dat
Derafsh.Client/Core/geosite.dat
Derafsh.Client/Core/xray.version
# local patch files
*.patch
