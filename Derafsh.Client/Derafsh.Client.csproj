<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>-->
		<!-- .NET 10 (LTS, supported to Nov 2028). .NET 9 support ended in May 2026. -->
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
		<MauiVersion>10.0.60</MauiVersion>
		<OutputType>Exe</OutputType>
		<RootNamespace>Derafsh.Client</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>Derafsh</ApplicationTitle>
		<ApplicationId>com.derafsh.client</ApplicationId>
		<ApplicationDisplayVersion>1.5.1</ApplicationDisplayVersion>
		<ApplicationVersion>7</ApplicationVersion>
		<Version>1.5.1</Version>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">12.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<GenerateAppInstallerFile>False</GenerateAppInstallerFile>
		<AppxPackageSigningEnabled>False</AppxPackageSigningEnabled>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<AppxAutoIncrementPackageRevision>True</AppxAutoIncrementPackageRevision>
		<AppxSymbolPackageEnabled>False</AppxSymbolPackageEnabled>
		<GenerateTestArtifacts>True</GenerateTestArtifacts>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    <WindowsPackageType>None</WindowsPackageType>
		<!-- Ship the Windows App runtime inside the app: it then runs without installing anything (and from F5 in VS) -->
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
		<!-- A MAUI app only needs the .NET runtime pack, not the ASP.NET / WindowsDesktop ones -->
		<DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.png" Color="#100B15" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#100B15" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Android: which phones the APK is for. -p:DerafshAndroidAbis=arm64 (default, most phones), armv7 (32-bit phones)
	     or universal (both). Chosen here and not with -p:RuntimeIdentifiers: dotnet publish reads a RID list given on the
	     command line as one RID. -->
	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-android'">
		<DerafshAndroidAbis Condition="'$(DerafshAndroidAbis)'==''">arm64</DerafshAndroidAbis>
		<RuntimeIdentifiers Condition="'$(DerafshAndroidAbis)'=='arm64'">android-arm64</RuntimeIdentifiers>
		<RuntimeIdentifiers Condition="'$(DerafshAndroidAbis)'=='armv7'">android-arm</RuntimeIdentifiers>
		<RuntimeIdentifiers Condition="'$(DerafshAndroidAbis)'=='universal'">android-arm64;android-arm</RuntimeIdentifiers>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<!-- Android engine: Xray (run as a process) + hev-socks5-tunnel (in-process VPN tunnel).
	     Not stored in git; downloaded and SHA-256 checked on first build.
	     Xray has no 32-bit Android build; its static linux-arm32-v7a build runs on Android (the app resolves the
	     server address itself, because a Linux binary can't find Android's DNS settings). -->
	<PropertyGroup>
		<XrayAndroidVersion>v26.3.27</XrayAndroidVersion>
		<XrayAndroidSha256>57149ffd48b629c07bf76938e73ab2729fde5910091497eab3e93d1c190f4c1b</XrayAndroidSha256>
		<XrayArm32Sha256>c7265ae13c63ca0241a037df4ef960ad37938c8a67d984cc08834b2cfdf5654b</XrayArm32Sha256>
		<HevVersion>2.19.1</HevVersion>
		<HevSha256>107958f7a07051386248ba8dba778b63d8dcefdfb2c3665b0ee9a8c93de5f6ca</HevSha256>
		<AndroidEngineDir>$(MSBuildProjectDirectory)\Platforms\Android</AndroidEngineDir>
	</PropertyGroup>
	<ItemGroup Condition="'$(TargetFramework)'=='net10.0-android'">
		<AndroidNativeLibrary Include="Platforms\Android\native\arm64-v8a\libxray.so" Abi="arm64-v8a" Condition="'$(DerafshAndroidAbis)'!='armv7'" />
		<AndroidNativeLibrary Include="Platforms\Android\native\armeabi-v7a\libxray.so" Abi="armeabi-v7a" Condition="'$(DerafshAndroidAbis)'!='arm64'" />
		<AndroidLibrary Include="Platforms\Android\libs\hev-socks5-tunnel.aar" />
	</ItemGroup>
	<Target Name="FetchAndroidEngine" BeforeTargets="_CheckForInvalidConfigurationAndPlatform;PrepareForBuild;_ResolveLibraryProjectImports" Condition="'$(TargetFramework)'=='net10.0-android'">
		<ItemGroup>
			<_Engine Include="arm64-v8a" Zip="Xray-android-arm64-v8a.zip" Sha="$(XrayAndroidSha256)" />
			<_Engine Include="armeabi-v7a" Zip="Xray-linux-arm32-v7a.zip" Sha="$(XrayArm32Sha256)" />
			<_EngineMissing Include="@(_Engine)" Condition="!Exists('$(AndroidEngineDir)\native\%(Identity)\libxray.so')" />
		</ItemGroup>
		<DownloadFile Condition="'@(_EngineMissing)'!=''" SourceUrl="https://github.com/XTLS/Xray-core/releases/download/$(XrayAndroidVersion)/%(_EngineMissing.Zip)" DestinationFolder="$(IntermediateOutputPath)xray-%(_EngineMissing.Identity)" />
		<GetFileHash Condition="'@(_EngineMissing)'!=''" Files="@(_EngineMissing->'$(IntermediateOutputPath)xray-%(Identity)\%(Zip)')" Algorithm="SHA256">
			<Output TaskParameter="Items" ItemName="_EngineZip" />
		</GetFileHash>
		<!-- MSBuild compares strings case-insensitively, so the upper-case hash matches the pinned one -->
		<Error Condition="'@(_EngineZip)'!='' And '%(_EngineZip.FileHash)' != '%(_EngineZip.Sha)'" Text="%(_EngineZip.Zip) failed its SHA-256 check." />
		<Unzip Condition="'@(_EngineMissing)'!=''" SourceFiles="$(IntermediateOutputPath)xray-%(_EngineMissing.Identity)\%(_EngineMissing.Zip)" DestinationFolder="$(IntermediateOutputPath)xray-%(_EngineMissing.Identity)\x" />
		<Copy Condition="'@(_EngineMissing)'!=''" SourceFiles="$(IntermediateOutputPath)xray-%(_EngineMissing.Identity)\x\xray" DestinationFiles="$(AndroidEngineDir)\native\%(_EngineMissing.Identity)\libxray.so" />

		<DownloadFile Condition="!Exists('$(AndroidEngineDir)\libs\hev-socks5-tunnel.aar')" SourceUrl="https://github.com/heiher/hev-socks5-tunnel/releases/download/$(HevVersion)/hev-socks5-tunnel.aar" DestinationFolder="$(AndroidEngineDir)\libs" />
		<GetFileHash Files="$(AndroidEngineDir)\libs\hev-socks5-tunnel.aar" Algorithm="SHA256">
			<Output TaskParameter="Hash" PropertyName="_HevSha" />
		</GetFileHash>
		<Error Condition="'$(_HevSha.ToLower())' != '$(HevSha256)'" Text="hev-socks5-tunnel.aar failed its SHA-256 check." />
	</Target>

	<!-- Windows engine: Xray-core for Windows in Core/. Not stored in git; downloaded and SHA-256 checked when
	     missing or when Core/xray.version doesn't match the pinned version. -->
	<PropertyGroup>
		<XrayWindowsVersion>v26.3.27</XrayWindowsVersion>
		<XrayWindowsSha256>d004c39288ce9ada487c6f398c7c545f7d749e44bdfdd59dbc9f865afba4e1ad</XrayWindowsSha256>
		<XrayCoreDir>$(MSBuildProjectDirectory)\Core</XrayCoreDir>
	</PropertyGroup>
	<Target Name="FetchWindowsEngine" BeforeTargets="PrepareForBuild" Condition="'$(TargetFramework)'=='net10.0-windows10.0.19041.0'">
		<ReadLinesFromFile File="$(XrayCoreDir)\xray.version" Condition="Exists('$(XrayCoreDir)\xray.version')">
			<Output TaskParameter="Lines" PropertyName="_XrayInstalled" />
		</ReadLinesFromFile>
		<PropertyGroup>
			<_XrayNeeded Condition="!Exists('$(XrayCoreDir)\xray.exe') Or '$(_XrayInstalled)' != '$(XrayWindowsVersion)'">true</_XrayNeeded>
		</PropertyGroup>
		<DownloadFile Condition="'$(_XrayNeeded)'=='true'" SourceUrl="https://github.com/XTLS/Xray-core/releases/download/$(XrayWindowsVersion)/Xray-windows-64.zip" DestinationFolder="$(IntermediateOutputPath)xray-windows" />
		<GetFileHash Condition="'$(_XrayNeeded)'=='true'" Files="$(IntermediateOutputPath)xray-windows\Xray-windows-64.zip" Algorithm="SHA256">
			<Output TaskParameter="Hash" PropertyName="_XrayWinSha" />
		</GetFileHash>
		<Error Condition="'$(_XrayNeeded)'=='true' And '$(_XrayWinSha.ToLower())' != '$(XrayWindowsSha256)'" Text="Xray Windows download failed its SHA-256 check." />
		<Unzip Condition="'$(_XrayNeeded)'=='true'" SourceFiles="$(IntermediateOutputPath)xray-windows\Xray-windows-64.zip" DestinationFolder="$(IntermediateOutputPath)xray-windows\x" />
		<Copy Condition="'$(_XrayNeeded)'=='true'" SourceFiles="$(IntermediateOutputPath)xray-windows\x\xray.exe;$(IntermediateOutputPath)xray-windows\x\geoip.dat;$(IntermediateOutputPath)xray-windows\x\geosite.dat" DestinationFolder="$(XrayCoreDir)" />
		<Copy Condition="'$(_XrayNeeded)'=='true'" SourceFiles="$(IntermediateOutputPath)xray-windows\x\LICENSE" DestinationFiles="$(XrayCoreDir)\LICENSE-Xray-core.txt" />
		<WriteLinesToFile Condition="'$(_XrayNeeded)'=='true'" File="$(XrayCoreDir)\xray.version" Lines="$(XrayWindowsVersion)" Overwrite="true" />
		<!-- Added here, not statically: on a fresh clone these files only exist after the download above -->
		<ItemGroup>
			<_XrayCoreFiles Include="Core\xray.exe;Core\geoip.dat;Core\geosite.dat;Core\LICENSE-Xray-core.txt" />
			<None Remove="@(_XrayCoreFiles)" />
			<None Include="@(_XrayCoreFiles)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
		</ItemGroup>
	</Target>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Windows-only files (the Android build gets its engine from Platforms/Android) -->
		<None Update="configs.txt" Condition="'$(TargetFramework)'=='net10.0-windows10.0.19041.0'">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>