<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Derafsh.Client.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                x:Name="StatusLabel"
                Text="وضعیت: قطع"
                FontSize="Large"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <!-- فیلد و دکمه اضافه کردن کانفیگ — فقط یک بار -->
            <Entry x:Name="ConfigInput" Placeholder="لینک کانفیگ را وارد کنید (vless:// یا ss://)" />
            <Button Text="افزودن کانفیگ" Clicked="OnAddConfigClicked" />

            <!-- لیست سرورها -->
            <ListView ItemsSource="{Binding Servers}" 
                      ItemSelected="OnServerSelected"
                      HeightRequest="450">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid Padding="10" ColumnDefinitions="Auto,*,Auto">
                                <Image Grid.Column="0" Source="{Binding FlagUrl}" WidthRequest="40" HeightRequest="30" VerticalOptions="Center"/>
                                <StackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0">
                                    <Label Text="{Binding Country}" FontSize="Medium" FontAttributes="Bold" />
                                    <Label Text="{Binding City}" FontSize="Small" />
                                </StackLayout>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button
                x:Name="ConnectButton"
                Text="اتصال"
                FontSize="Large"
                Clicked="OnConnectButtonClicked"
                HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>