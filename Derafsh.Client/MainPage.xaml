<?xml version="1.0" encoding="utf-8" ?>
<!--
    Five views on one page, one visible at a time:
      HomeView       the simple screen: one round Connect button and where it connects (a country or city, or a server picked by hand).
      LocationsView  pick a country or a city: where the servers come out on the internet (what websites see).
      ServersView    the detailed screen: pick a list (Online / Personal / a saved list), test, add, choose a server.
                     Each row has one "more" button (test, Gemini, share, star, save, delete) instead of six.
      SettingsView   the options (Iranian sites without VPN, Gemini only), the subscription link, the Telegram channel.
      AppsView       (Android) which apps use the VPN; opened from Settings.
    The app is Persian, so the page flows right to left; ping numbers stay Latin (mono) so they line up.
    Android: the page is drawn edge to edge; the code pads RootGrid by the real status-bar / navigation-bar sizes
    (SafeAreaEdges=Container didn't keep the content out from under the status bar on a phone).
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Derafsh.Client"
             xmlns:models="clr-namespace:Derafsh.Client.Models"
             x:Class="Derafsh.Client.MainPage"
             BackgroundColor="{StaticResource Bg}" Shell.NavBarIsVisible="False" NavigationPage.HasNavigationBar="False"
             FlowDirection="RightToLeft" SafeAreaEdges="None">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:BoolToColorConverter x:Key="SelectedStroke" TrueColor="{StaticResource Accent}" FalseColor="{StaticResource Hairline}" />
            <local:PingToTextConverter x:Key="PingText" />
            <local:PingToColorConverter x:Key="PingColor" Untested="{StaticResource TextMuted}" Good="{StaticResource Success}" Slow="{StaticResource Warning}" Bad="{StaticResource Danger}" />
            <local:SpeedToTextConverter x:Key="SpeedText" />
            <local:SpeedToColorConverter x:Key="SpeedColor" Good="{StaticResource Success}" Slow="{StaticResource Warning}" Bad="{StaticResource Danger}" />
            <local:GeminiTextConverter x:Key="GeminiText" />
            <local:GeminiColorConverter x:Key="GeminiColor" Neutral="{StaticResource TextMuted}" Good="{StaticResource Success}" Warn="{StaticResource Warning}" Bad="{StaticResource Danger}" />

            <!-- Desktop row: name and details, results, then one "more" button -->
            <DataTemplate x:Key="WideRow" x:DataType="models:Server">
                <ViewCell>
                    <Border Margin="0,3" Padding="16,10" BackgroundColor="{StaticResource Surface}" StrokeThickness="1" StrokeShape="RoundRectangle 8"
                            Stroke="{Binding IsSelected, Converter={StaticResource SelectedStroke}}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceHover}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>

                        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="4">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Text="✦" IsVisible="{Binding IsFavorite}" TextColor="{StaticResource Accent}" FontSize="14" VerticalOptions="Center" Margin="0,0,6,0" />
                                <Label Grid.Column="1" Text="{Binding City}" FontFamily="{StaticResource FontStrong}" FontSize="15" LineBreakMode="TailTruncation" MaxLines="1" />
                            </Grid>
                            <Label Grid.Row="1" Text="{Binding Meta}" Style="{StaticResource MetaLabel}" LineBreakMode="TailTruncation" MaxLines="1" VerticalOptions="Center" />

                            <HorizontalStackLayout Grid.Column="1" Spacing="16" HorizontalOptions="End">
                                <Label Text="{Binding Speed, Converter={StaticResource SpeedText}}" TextColor="{Binding Speed, Converter={StaticResource SpeedColor}}"
                                       FontFamily="{StaticResource FontMono}" FontSize="13" VerticalOptions="Center"
                                       ToolTipProperties.Text="سرعت دانلود از داخل این سرور؛ برای ویدیو دست‌کم ۱۵۰ کیلوبایت بر ثانیه لازم است" />
                                <Label Text="{Binding Ping, Converter={StaticResource PingText}}" TextColor="{Binding Ping, Converter={StaticResource PingColor}}"
                                       FontFamily="{StaticResource FontMono}" FontSize="13" MinimumWidthRequest="72" HorizontalTextAlignment="End" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsPinging}" Value="True">
                                            <Setter Property="Text" Value="در حال تست…" />
                                            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
                                            <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding GeminiStatus, Converter={StaticResource GeminiText}}" TextColor="{Binding GeminiStatus, Converter={StaticResource GeminiColor}}"
                                   FontSize="12" HorizontalOptions="End" VerticalOptions="Center" />

                            <Button Grid.Column="2" Grid.RowSpan="2" Text="⋯" Style="{StaticResource RowButton}" FontSize="18" WidthRequest="40" HeightRequest="36" Padding="0"
                                    VerticalOptions="Center" Clicked="OnRowMoreClicked" CommandParameter="{Binding .}"
                                    SemanticProperties.Description="کارهای این سرور"
                                    ToolTipProperties.Text="تست سرعت، Gemini، اشتراک، ستاره، افزودن به لیست شخصی" />
                        </Grid>
                    </Border>
                </ViewCell>
            </DataTemplate>

            <!-- Phone row: name and results, then details; the "more" button at the end -->
            <DataTemplate x:Key="CompactRow" x:DataType="models:Server">
                <ViewCell>
                    <Border Margin="0,4" Padding="14,10" BackgroundColor="{StaticResource Surface}" StrokeThickness="1" StrokeShape="RoundRectangle 8"
                            Stroke="{Binding IsSelected, Converter={StaticResource SelectedStroke}}">
                        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Text="✦" IsVisible="{Binding IsFavorite}" TextColor="{StaticResource Accent}" FontSize="14" VerticalOptions="Center" Margin="0,0,6,0" />
                                <Label Grid.Column="1" Text="{Binding City}" FontFamily="{StaticResource FontStrong}" FontSize="15" LineBreakMode="TailTruncation" MaxLines="1" />
                            </Grid>
                            <HorizontalStackLayout Grid.Column="1" Spacing="10" HorizontalOptions="End">
                                <Label Text="{Binding Speed, Converter={StaticResource SpeedText}}" TextColor="{Binding Speed, Converter={StaticResource SpeedColor}}"
                                       FontFamily="{StaticResource FontMono}" FontSize="13" VerticalOptions="Center" />
                                <Label Text="{Binding Ping, Converter={StaticResource PingText}}" TextColor="{Binding Ping, Converter={StaticResource PingColor}}"
                                       FontFamily="{StaticResource FontMono}" FontSize="13" HorizontalTextAlignment="End" VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsPinging}" Value="True">
                                            <Setter Property="Text" Value="در حال تست…" />
                                            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
                                            <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>
                            <Label Grid.Row="1" Text="{Binding Meta}" Style="{StaticResource MetaLabel}" LineBreakMode="TailTruncation" MaxLines="1" VerticalOptions="Center" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding GeminiStatus, Converter={StaticResource GeminiText}}" TextColor="{Binding GeminiStatus, Converter={StaticResource GeminiColor}}"
                                   FontSize="12" HorizontalOptions="End" VerticalOptions="Center" />
                            <Button Grid.Column="2" Grid.RowSpan="2" Text="⋯" Style="{StaticResource RowButton}" FontSize="18" WidthRequest="44" HeightRequest="44" Padding="0"
                                    VerticalOptions="Center" Clicked="OnRowMoreClicked" CommandParameter="{Binding .}"
                                    SemanticProperties.Description="کارهای این سرور" />
                        </Grid>
                    </Border>
                </ViewCell>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid x:Name="RootGrid" RowDefinitions="2,Auto,*,Auto">
        <!-- The banner's crimson frame -->
        <BoxView Color="{StaticResource Crimson}" HeightRequest="2" />

        <!-- A new version is on GitHub: one quiet line, the gold stays on Connect -->
        <Border x:Name="UpdateBanner" Grid.Row="1" IsVisible="False" Style="{StaticResource Card}" Stroke="{StaticResource Accent}"
                Margin="16,10,16,0" Padding="14,8" MaximumWidthRequest="880">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label x:Name="UpdateText" VerticalOptions="Center" LineBreakMode="WordWrap" MaxLines="2" />
                <Button Grid.Column="1" Text="دانلود" Style="{StaticResource SecondaryButton}" Clicked="OnUpdateDownloadClicked" VerticalOptions="Center"
                        ToolTipProperties.Text="فایل نسخه‌ی تازه‌ی مخصوص همین دستگاه را از گیت‌هاب دانلود می‌کند" />
                <Button Grid.Column="2" Text="بعداً" Style="{StaticResource SecondaryButton}" BorderColor="Transparent" Clicked="OnUpdateLaterClicked" VerticalOptions="Center"
                        ToolTipProperties.Text="این نسخه را دیگر یادآوری نکن" />
            </Grid>
        </Border>

        <!-- ================= Home: the simple screen ================= -->
        <Grid x:Name="HomeView" Grid.Row="2" RowDefinitions="Auto,*,Auto" RowSpacing="12" Padding="20,16,20,8" MaximumWidthRequest="480">

            <!-- Brand; the two detailed screens -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <Image Source="derafsh_logo.png" HeightRequest="40" WidthRequest="40" VerticalOptions="Center" SemanticProperties.Description="درفش کاویانی" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0" Margin="4,0,0,0">
                    <Label Text="درفش" FontFamily="{StaticResource FontPersian}" FontSize="22" />
                    <Label x:Name="BrandLabel" Text="DERAFSH" Style="{StaticResource BrandLatinLabel}" HorizontalOptions="Start" />
                </VerticalStackLayout>
                <Button x:Name="OpenServersButton" Grid.Column="2" Text="سرورها" Style="{StaticResource SecondaryButton}" Clicked="OnOpenServersClicked" VerticalOptions="Center"
                        ToolTipProperties.Text="لیست سرورها، تست، لیست‌های ذخیره‌شده و افزودن کانفیگ" />
                <Button Grid.Column="3" Text="تنظیمات" Style="{StaticResource SecondaryButton}" Clicked="OnOpenSettingsClicked" VerticalOptions="Center"
                        ToolTipProperties.Text="سایت‌های ایرانی بدون VPN، Gemini، لینک اشتراک و کانال تلگرام" />
            </Grid>

            <!-- The one action -->
            <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Spacing="16">
                <Border x:Name="ConnRing" StrokeShape="Ellipse" StrokeThickness="2" Stroke="{StaticResource Hairline}" Padding="10"
                        HorizontalOptions="Center" BackgroundColor="Transparent">
                    <Button x:Name="ConnectButton" Text="اتصال" Style="{StaticResource ConnectCircle}" Clicked="OnConnectButtonClicked"
                            SemanticProperties.Description="اتصال" />
                </Border>
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="ConnStateLabel" Text="وصل نیستید" Style="{StaticResource TitleLabel}" HorizontalTextAlignment="Center" />
                    <Label x:Name="ConnDetailLabel" TextColor="{StaticResource TextSecondary}" FontSize="13" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" MaxLines="2" />
                    <Button x:Name="ManualSwitchButton" IsVisible="False" Text="تعویض سرور" Style="{StaticResource SecondaryButton}" HorizontalOptions="Center"
                            Clicked="OnManualSwitchClicked" Margin="0,8,0,0"
                            ToolTipProperties.Text="همین الان به یک سرور سالم دیگر برو (مثلاً وقتی ویدیو پخش نمی‌شود)" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Where Connect goes: a country or city, or the server picked by hand -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOpenLocationsTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label x:Name="LocationCaptionLabel" Text="مکان سرور" Style="{StaticResource MetaLabel}" />
                        <Label x:Name="LocationTitleLabel" Text="خودکار، هر کشوری" FontFamily="{StaticResource FontStrong}" LineBreakMode="TailTruncation" MaxLines="1" />
                    </VerticalStackLayout>
                    <Button x:Name="AutoServerButton" Grid.Column="1" Text="خودکار" Style="{StaticResource SecondaryButton}" Clicked="OnAutoServerClicked" IsVisible="False"
                            VerticalOptions="Center" ToolTipProperties.Text="برنامه خودش سریع‌ترین سرور را انتخاب کند" />
                    <Button Grid.Column="2" Text="انتخاب مکان" Style="{StaticResource SecondaryButton}" Clicked="OnOpenLocationsClicked" VerticalOptions="Center"
                            ToolTipProperties.Text="کشور یا شهری را انتخاب کنید که سرورها از آنجا به اینترنت وصل شوند" />
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Locations: a country or a city ================= -->
        <Grid x:Name="LocationsView" Grid.Row="2" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10" Padding="20,16,20,8" MaximumWidthRequest="600">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="→ بازگشت" Style="{StaticResource SecondaryButton}" Clicked="OnLocationsBackClicked" VerticalOptions="Center"
                        ToolTipProperties.Text="بازگشت به صفحه‌ی اتصال" />
                <Label Grid.Column="1" Text="مکان سرور" Style="{StaticResource TitleLabel}" VerticalOptions="Center" />
            </Grid>
            <Label Grid.Row="1" TextColor="{StaticResource TextSecondary}" FontSize="13" LineBreakMode="WordWrap"
                   Text="جایی که سرور به اینترنت وصل می‌شود و سایت‌ها شما را آنجا می‌بینند. «سالم» یعنی روی همین اینترنت جواب داده است." />
            <Entry x:Name="LocationSearch" Grid.Row="2" Placeholder="جستجو، مثلاً آلمان یا Berlin" TextChanged="OnLocationSearchChanged" ClearButtonVisibility="WhileEditing"
                   TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextMuted}" BackgroundColor="{StaticResource Surface}"
                   FontFamily="{StaticResource FontBody}" FontSize="14" />
            <CollectionView x:Name="LocationsList" Grid.Row="3" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:LocationRow">
                        <Border Margin="0,3" Padding="0" BackgroundColor="{StaticResource Surface}" StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                Stroke="{Binding IsSelected, Converter={StaticResource SelectedStroke}}">
                            <Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="14,10">
                                <!-- cities sit under their country -->
                                <BoxView WidthRequest="0" HeightRequest="1" Color="Transparent">
                                    <BoxView.Triggers>
                                        <DataTrigger TargetType="BoxView" Binding="{Binding IsCity}" Value="True">
                                            <Setter Property="WidthRequest" Value="16" />
                                        </DataTrigger>
                                    </BoxView.Triggers>
                                </BoxView>
                                <Label Grid.Column="1" Text="{Binding Title}" FontFamily="{StaticResource FontStrong}" FontSize="15" VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" MaxLines="1">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsCity}" Value="True">
                                            <Setter Property="FontFamily" Value="{StaticResource FontBody}" />
                                            <Setter Property="FontSize" Value="14" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource MetaLabel}" VerticalOptions="Center" />
                            </Grid>
                            <!-- the whole row is one button: taps, keyboard and screen readers -->
                            <Button Style="{StaticResource OverlayButton}" Clicked="OnLocationClicked" CommandParameter="{Binding .}"
                                    SemanticProperties.Description="{Binding Title}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label x:Name="LocationsEmptyLabel" Text="چیزی با این اسم پیدا نشد." TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" Margin="0,24" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <!-- ================= Servers: the detailed screen ================= -->
        <Grid x:Name="ServersView" Grid.Row="2" IsVisible="False" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12" Padding="24,16,24,8">

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="→ بازگشت" Style="{StaticResource SecondaryButton}" Clicked="OnBackToHomeClicked" VerticalOptions="Center"
                        ToolTipProperties.Text="بازگشت به صفحه‌ی اتصال" />
                <Label Grid.Column="1" Text="سرورها" Style="{StaticResource TitleLabel}" VerticalOptions="Center" />
            </Grid>

            <!-- Which list -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Label Text="لیست:" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                <Picker x:Name="ListPicker" Grid.Column="1" SelectedIndexChanged="OnListPicked" TextColor="{StaticResource TextPrimary}" BackgroundColor="{StaticResource Surface}"
                        FontFamily="{StaticResource FontBody}" FontSize="14" SemanticProperties.Description="انتخاب لیست سرورها" />
            </Grid>

            <!-- What this list can do; the rarely used ones under "more" -->
            <FlexLayout x:Name="ActionsBar" Grid.Row="2" Wrap="Wrap" AlignItems="Center">
                <Button x:Name="TestAllButton" Text="تست دوباره" Style="{StaticResource SecondaryButton}" Clicked="OnTestAgainClicked" Margin="0,0,8,8"
                        ToolTipProperties.Text="سرورهای این لیست را دوباره روی همین اینترنت تست می‌کند" />
                <Button x:Name="RefreshButton" Text="دریافت لیست تازه" Style="{StaticResource SecondaryButton}" Clicked="OnUpdateOnlineClicked" Margin="0,0,8,8"
                        ToolTipProperties.Text="جدیدترین کانفیگ‌های رایگان را دانلود و تست می‌کند (هر ۲ ساعت تازه می‌شوند)" />
                <Button x:Name="AddConfigButton" Text="افزودن کانفیگ" Style="{StaticResource SecondaryButton}" Clicked="OnAddCustomConfigClicked" Margin="0,0,8,8"
                        ToolTipProperties.Text="لینک‌های خودتان (vless / vmess / ss / trojan / hysteria2) را اضافه می‌کند" />
                <Button x:Name="ListMoreButton" Text="بیشتر…" Style="{StaticResource SecondaryButton}" Clicked="OnListMoreClicked" Margin="0,0,8,8"
                        ToolTipProperties.Text="ذخیره‌ی سالم‌ها به‌عنوان لیست، اشتراک سالم‌ها، حذف لیست" />
            </FlexLayout>

            <!-- Server list -->
            <ListView x:Name="ServerListView" Grid.Row="3" IsGroupingEnabled="True" HasUnevenRows="True" SeparatorVisibility="None"
                      BackgroundColor="Transparent" SelectionMode="Single" ItemSelected="OnServerSelected" ItemTemplate="{StaticResource WideRow}">
                <ListView.GroupHeaderTemplate>
                    <DataTemplate x:DataType="local:ServerGroup">
                        <ViewCell>
                            <Label Text="{Binding Name}" Style="{StaticResource SectionLabel}" Padding="2,8,0,6" LineBreakMode="TailTruncation" MaxLines="1" />
                        </ViewCell>
                    </DataTemplate>
                </ListView.GroupHeaderTemplate>
            </ListView>

            <!-- Empty list -->
            <VerticalStackLayout x:Name="EmptyState" Grid.Row="3" IsVisible="False" Spacing="8" VerticalOptions="Center" HorizontalOptions="Center" MaximumWidthRequest="440">
                <Label x:Name="EmptyTitle" FontFamily="{StaticResource FontStrong}" FontSize="16" HorizontalTextAlignment="Center" />
                <Label x:Name="EmptyText" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Connection, without going back to the home screen -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <BoxView x:Name="MiniDot" WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="{StaticResource TextMuted}" VerticalOptions="Center" />
                    <Label x:Name="MiniStateLabel" Grid.Column="1" Text="وصل نیستید" VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                    <Button x:Name="MiniConnectButton" Grid.Column="2" Text="اتصال" Style="{StaticResource PrimaryButton}" Clicked="OnConnectButtonClicked" VerticalOptions="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- ================= Settings ================= -->
        <ScrollView x:Name="SettingsView" Grid.Row="2" IsVisible="False">
            <VerticalStackLayout Padding="20,16,20,16" Spacing="12" MaximumWidthRequest="600">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Button Text="→ بازگشت" Style="{StaticResource SecondaryButton}" Clicked="OnSettingsBackClicked" VerticalOptions="Center"
                            ToolTipProperties.Text="بازگشت به صفحه‌ی اتصال" />
                    <Label Grid.Column="1" Text="تنظیمات" Style="{StaticResource TitleLabel}" VerticalOptions="Center" />
                </Grid>

                <Label Text="اتصال" Style="{StaticResource SectionLabel}" Margin="0,8,0,0" />
                <Border Style="{StaticResource Card}" Padding="12,8">
                    <VerticalStackLayout Spacing="2">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                            <CheckBox x:Name="IranDirectCheck" Color="{StaticResource TextSecondary}" VerticalOptions="Center" CheckedChanged="OnIranDirectChanged"
                                      SemanticProperties.Description="برنامه‌ها و سایت‌های ایرانی بدون VPN" />
                            <Label x:Name="IranDirectLabel" Grid.Column="1" Text="برنامه‌ها و سایت‌های ایرانی بدون VPN (بانک‌ها، درگاه پرداخت، سایت‌های &#x200E;.ir&#x200E;)" Style="{StaticResource OptionLabel}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnIranDirectLabelTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <Button x:Name="ChooseAppsButton" Text="انتخاب برنامه‌ها" Style="{StaticResource SecondaryButton}" Clicked="OnOpenAppsClicked"
                                HorizontalOptions="Start" Margin="40,0,0,8" IsVisible="False"
                                ToolTipProperties.Text="خودتان انتخاب کنید کدام برنامه‌ها بدون VPN کار کنند" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="4">
                            <CheckBox x:Name="GeminiCheck" Color="{StaticResource TextSecondary}" VerticalOptions="Center" CheckedChanged="OnGeminiOptionChanged"
                                      SemanticProperties.Description="فقط سرورهایی که Gemini، هوش مصنوعی گوگل، را باز می‌کنند" />
                            <Label Grid.Column="1" Text="فقط سرورهایی که Gemini (هوش مصنوعی گوگل) را باز می‌کنند" Style="{StaticResource OptionLabel}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnGeminiLabelTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="اشتراک و خبرها" Style="{StaticResource SectionLabel}" Margin="0,8,0,0" />
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="لینک اشتراک درفش" FontFamily="{StaticResource FontStrong}" />
                            <Label Text="برای آیفون و برنامه‌های دیگر: Hiddify، V2Box، Streisand، v2rayNG" Style="{StaticResource MetaLabel}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="نمایش QR" Style="{StaticResource SecondaryButton}" Clicked="OnShareSubscriptionClicked" VerticalOptions="Center"
                                ToolTipProperties.Text="لینک و QR اشتراک درفش؛ لیست هر ۲ ساعت خودکار تازه می‌شود" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="کانال تلگرام درفش" FontFamily="{StaticResource FontStrong}" />
                            <Label Text="@DERAFSHVPN · خبر نسخه‌های تازه" Style="{StaticResource MetaLabel}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="باز کردن کانال" Style="{StaticResource SecondaryButton}" Clicked="OnOpenTelegramClicked" VerticalOptions="Center"
                                ToolTipProperties.Text="t.me/DERAFSHVPN را باز می‌کند" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource Card}" Padding="16,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="درفش در گیت‌هاب" FontFamily="{StaticResource FontStrong}" />
                            <Label Text="کد برنامه و همه‌ی نسخه‌ها؛ با ستاره دادن کمک کنید بقیه هم پیدایش کنند" Style="{StaticResource MetaLabel}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="باز کردن" Style="{StaticResource SecondaryButton}" Clicked="OnOpenGitHubClicked" VerticalOptions="Center"
                                ToolTipProperties.Text="github.com/Mehinator/Derafsh را باز می‌کند" />
                    </Grid>
                </Border>
                <Label x:Name="VersionLabel" Style="{StaticResource BrandLatinLabel}" HorizontalOptions="Center" Margin="0,8,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- ================= Apps and VPN (Android): which apps use the VPN ================= -->
        <Grid x:Name="AppsView" Grid.Row="2" IsVisible="False" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="10" Padding="20,16,20,8" MaximumWidthRequest="600">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="→ بازگشت" Style="{StaticResource SecondaryButton}" Clicked="OnAppsBackClicked" VerticalOptions="Center"
                        ToolTipProperties.Text="بازگشت به تنظیمات" />
                <Label Grid.Column="1" Text="برنامه‌ها و VPN" Style="{StaticResource TitleLabel}" VerticalOptions="Center" />
            </Grid>
            <!-- Two ways, like most VPN apps -->
            <VerticalStackLayout Grid.Row="1" Spacing="0">
                <RadioButton x:Name="AllAppsMode" GroupName="AppsMode" Content="همه‌ی برنامه‌ها با VPN، جز آن‌هایی که خاموش کنید" CheckedChanged="OnAppsModeChanged"
                             TextColor="{StaticResource TextPrimary}" FontFamily="{StaticResource FontBody}" FontSize="14" />
                <RadioButton x:Name="OnlyAppsMode" GroupName="AppsMode" Content="فقط برنامه‌هایی که روشن کنید با VPN" CheckedChanged="OnAppsModeChanged"
                             TextColor="{StaticResource TextPrimary}" FontFamily="{StaticResource FontBody}" FontSize="14" />
            </VerticalStackLayout>
            <Label x:Name="AppsHint" Grid.Row="2" TextColor="{StaticResource TextSecondary}" FontSize="13" LineBreakMode="WordWrap" />
            <Entry x:Name="AppSearch" Grid.Row="3" Placeholder="جستجوی برنامه" TextChanged="OnAppSearchChanged" ClearButtonVisibility="WhileEditing"
                   TextColor="{StaticResource TextPrimary}" PlaceholderColor="{StaticResource TextMuted}" BackgroundColor="{StaticResource Surface}"
                   FontFamily="{StaticResource FontBody}" FontSize="14" />
            <CollectionView x:Name="AppsList" Grid.Row="4" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AppEntry">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="4,8">
                            <Image Source="{Binding Icon}" WidthRequest="36" HeightRequest="36" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                                <Label Text="{Binding Name}" LineBreakMode="TailTruncation" MaxLines="1" />
                                <Label Text="{Binding Note}" Style="{StaticResource MetaLabel}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="2" IsToggled="{Binding UsesVpn, Mode=TwoWay}" OnColor="{StaticResource Accent}" ThumbColor="{StaticResource TextPrimary}"
                                    VerticalOptions="Center" SemanticProperties.Description="{Binding Name}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label x:Name="AppsEmptyLabel" Text="در حال خواندن برنامه‌های گوشی…" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" Margin="0,24" />
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <!-- Status bar: what just happened (tests, downloads, saves) -->
        <Label x:Name="StatusLabel" Grid.Row="3" TextColor="{StaticResource TextSecondary}" FontSize="13" Padding="24,0,24,10"
               HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="2" />
    </Grid>
</ContentPage>
