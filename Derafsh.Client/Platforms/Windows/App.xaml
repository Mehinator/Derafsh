<maui:MauiWinUIApplication
    x:Class="Derafsh.Client.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:maui="using:Microsoft.Maui"
    xmlns:local="using:Derafsh.Client.WinUI"
    RequestedTheme="Dark">

    <maui:MauiWinUIApplication.Resources>
        <ResourceDictionary>
            <!-- System accent = Derafsh gold (dialog buttons, text box focus line), instead of Windows blue.
                 In the dark theme WinUI fills accent buttons with Light2 and puts dark text on it. -->
            <Color x:Key="SystemAccentColor">#F2C14E</Color>
            <Color x:Key="SystemAccentColorLight1">#D9A933</Color>
            <Color x:Key="SystemAccentColorLight2">#F2C14E</Color>
            <Color x:Key="SystemAccentColorLight3">#F6CF6E</Color>
            <Color x:Key="SystemAccentColorDark1">#D9A933</Color>
            <Color x:Key="SystemAccentColorDark2">#B98D24</Color>
            <Color x:Key="SystemAccentColorDark3">#8F6C17</Color>

            <!-- No system blue selection/hover in the server list: the app draws its own selected row -->
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPointerOverBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ListViewItemSelectionIndicatorPressedBrush" Color="Transparent" />
        </ResourceDictionary>
    </maui:MauiWinUIApplication.Resources>

</maui:MauiWinUIApplication>
